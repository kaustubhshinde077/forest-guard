# Forest Guard Environment Configuration

# Copernicus Data Space Ecosystem (CDSE)
# Register free at https://dataspace.copernicus.eu
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# AI Model Provider: Google Gemini
# Obtain key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Web Search Provider: Tavily
# Obtain free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Forest Guard Application Settings
FORESTGUARD_ENV=development
FORESTGUARD_LOG_LEVEL=INFO
FORESTGUARD_DEFAULT_REGION="Maharashtra Western Ghats"
FORESTGUARD_SIGNIFICANCE_THRESHOLD_HA=1.0
FORESTGUARD_DATA_DIR=./data
FORESTGUARD_FIXTURES_DIR=./data/fixtures

# Optional AWS Deployment Settings (Leave blank until ready to deploy)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
